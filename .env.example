# =============================================================================
# Low-Code Performance Scanner - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# General Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=your-secret-key-here-change-in-production

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# CORS Settings (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Low-Code Performance Scanner

# =============================================================================
# Scanner Configuration
# =============================================================================
# Maximum number of concurrent scans
MAX_CONCURRENT_SCANS=2

# Default scan timeout in seconds
SCAN_TIMEOUT=300

# Default number of runs per scenario
DEFAULT_RUNS_PER_SCENARIO=3

# Output directory for reports
OUTPUT_DIR=./reports

# =============================================================================
# Browser Configuration
# =============================================================================
# Playwright browser to use (chromium, firefox, webkit)
BROWSER_TYPE=chromium

# Run browser in headless mode
HEADLESS=true

# Browser window width
BROWSER_WIDTH=1920

# Browser window height
BROWSER_HEIGHT=1080

# =============================================================================
# Performance Settings
# =============================================================================
# Enable memory profiling
ENABLE_MEMORY_PROFILING=true

# Enable network monitoring
ENABLE_NETWORK_MONITORING=true

# Enable performance tracing
ENABLE_PERFORMANCE_TRACING=true

# Capture screenshots during scans
CAPTURE_SCREENSHOTS=true

# Record videos during scans
RECORD_VIDEOS=false

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# =============================================================================
# Database Configuration (Optional - for persistent storage)
# =============================================================================
DATABASE_URL=sqlite:///./scanner.db
# DATABASE_URL=postgresql://user:password@localhost/scanner

# =============================================================================
# External Services
# =============================================================================
# Optional: Sentry DSN for error tracking
SENTRY_DSN=

# Optional: Analytics API key
ANALYTICS_API_KEY=

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@lowcode-scanner.local

# =============================================================================
# Cloud Storage (Optional)
# =============================================================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=

# =============================================================================
# Security Settings
# =============================================================================
# Enable API rate limiting
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# API key for external access
API_KEY=

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
